{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["git", "defaults", "applications"],
  "properties": {
    "git": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "required": ["project", "destinationServer", "prune", "selfHeal", "createNamespace", "finalizers"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "destinationServer": {"type": "string", "minLength": 1},
        "prune": {"type": "boolean"},
        "selfHeal": {"type": "boolean"},
        "createNamespace": {"type": "boolean"},
        "finalizers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "repository", "chart", "targetRevision", "namespace", "syncWave"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "repository": {"type": "string", "minLength": 1},
          "chart": {"type": "string", "minLength": 1},
          "targetRevision": {"type": "string", "minLength": 1},
          "valuesFile": {"type": "string", "minLength": 1},
          "namespace": {"type": "string", "minLength": 1},
          "syncWave": {"type": "integer"},
          "prune": {"type": "boolean"},
          "selfHeal": {"type": "boolean"},
          "createNamespace": {"type": "boolean"},
          "finalizers": {"type": "array", "items": {"type": "string"}},
          "syncOptions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
